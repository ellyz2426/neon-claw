<style>
  .go-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 8, 17, 0.95);
    border-color: #ff00ff;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .go-title {
    font-size: 3.5;
    color: #ff00ff;
    font-weight: bold;
    margin-bottom: 1.5;
  }
  .go-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-bottom: 0.5;
  }
  .go-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .go-label {
    font-size: 1;
    color: #889999;
  }
  .go-value {
    font-size: 2;
    color: #00ffff;
    font-weight: bold;
  }
  .go-score-big {
    font-size: 4;
    color: #ffdd00;
    font-weight: bold;
    margin-bottom: 1;
  }
  .go-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70%;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 2;
    padding-right: 2;
    margin-top: 0.6;
    background-color: rgba(0, 255, 255, 0.08);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.5;
    cursor: pointer;
  }
  .go-btn-text {
    font-size: 2;
    color: #00ffff;
    font-weight: bold;
  }
  .title-btn {
    border-color: #ff00ff;
  }
  .title-btn-text {
    color: #ff00ff;
  }
</style>
<div class="go-panel">
  <span class="go-title">GAME OVER</span>
  <span id="go-score" class="go-score-big">0</span>
  <div class="go-row">
    <div class="go-stat">
      <span class="go-label">GRABS</span>
      <span id="go-grabs" class="go-value">0</span>
    </div>
    <div class="go-stat">
      <span class="go-label">MISSES</span>
      <span id="go-misses" class="go-value">0</span>
    </div>
    <div class="go-stat">
      <span class="go-label">ACCURACY</span>
      <span id="go-accuracy" class="go-value">0%</span>
    </div>
  </div>
  <div class="go-row">
    <div class="go-stat">
      <span class="go-label">STREAK</span>
      <span id="go-streak" class="go-value">0</span>
    </div>
    <div class="go-stat">
      <span class="go-label">COMBO</span>
      <span id="go-combo" class="go-value">x1</span>
    </div>
    <div class="go-stat">
      <span class="go-label">TICKETS</span>
      <span id="go-tickets" class="go-value">0</span>
    </div>
  </div>
  <div id="btn-rematch" class="go-btn"><span class="go-btn-text">REMATCH</span></div>
  <div id="btn-title" class="go-btn title-btn"><span class="go-btn-text title-btn-text">TITLE</span></div>
</div>
