<panel>
  <container
    flexDirection="column"
    alignItems="center"
    padding={16}
    gap={8}
    backgroundColor="#0a0a1a"
    borderColor="#00ffff"
    borderWidth={2}
    borderRadius={12}
  >
    <text fontSize={22} fontWeight="bold" color="#00ffff">🛒 TICKET SHOP</text>
    <text id="shop-tickets" fontSize={14} color="#ffdd00">🎫 Tickets: 0</text>

    <text fontSize={16} fontWeight="bold" color="#ff8800" marginTop={8}>Consumables</text>
    <container flexDirection="column" gap={4} width="100%">
      <container id="btn-shop-0" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-0" fontSize={12} color="#ccddff">🎟️ Extra Attempt — +1 attempt</text>
        <text id="shop-cost-0" fontSize={12} color="#ffdd00">8 🎫</text>
      </container>
      <container id="btn-shop-1" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-1" fontSize={12} color="#ccddff">💪 Starter Grip+ — Strong Grip start</text>
        <text id="shop-cost-1" fontSize={12} color="#ffdd00">12 🎫</text>
      </container>
      <container id="btn-shop-2" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-2" fontSize={12} color="#ccddff">🧲 Starter Magnet — Magnet start</text>
        <text id="shop-cost-2" fontSize={12} color="#ffdd00">12 🎫</text>
      </container>
      <container id="btn-shop-3" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-3" fontSize={12} color="#ccddff">🍀 Lucky Charm — +15% grab chance</text>
        <text id="shop-cost-3" fontSize={12} color="#ffdd00">15 🎫</text>
      </container>
      <container id="btn-shop-4" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-4" fontSize={12} color="#ccddff">⚡ XP Boost — 2x XP next game</text>
        <text id="shop-cost-4" fontSize={12} color="#ffdd00">20 🎫</text>
      </container>
    </container>

    <text fontSize={16} fontWeight="bold" color="#aa44ff" marginTop={8}>Permanent Boosts</text>
    <container flexDirection="column" gap={4} width="100%">
      <container id="btn-shop-5" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-5" fontSize={12} color="#ccddff">🎫 Ticket Magnet — +10% tickets</text>
        <text id="shop-cost-5" fontSize={12} color="#ffdd00">100 🎫</text>
      </container>
      <container id="btn-shop-6" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer">
        <text id="shop-item-6" fontSize={12} color="#ccddff">🔍 Prize Scanner — See rarity glow</text>
        <text id="shop-cost-6" fontSize={12} color="#ffdd00">75 🎫</text>
      </container>
    </container>

    <text fontSize={16} fontWeight="bold" color="#00ff88" marginTop={8}>Utility</text>
    <container id="btn-shop-7" flexDirection="row" alignItems="center" justifyContent="space-between" padding={6} backgroundColor="#111133" borderRadius={6} cursor="pointer" width="100%">
      <text id="shop-item-7" fontSize={12} color="#ccddff">🔄 Reroll Daily — New daily seed</text>
      <text id="shop-cost-7" fontSize={12} color="#ffdd00">25 🎫</text>
    </container>

    <text id="shop-result" fontSize={13} color="#00ff88" marginTop={4}></text>

    <container id="btn-back-shop" padding={8} backgroundColor="#333355" borderRadius={8} cursor="pointer" marginTop={8}>
      <text fontSize={14} color="#aaccff">← Back</text>
    </container>
  </container>
</panel>
