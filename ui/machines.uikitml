<style>
  .machines-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 8, 17, 0.92);
    border-color: #ff8800;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .machines-title {
    font-size: 3;
    color: #ff8800;
    font-weight: bold;
    margin-bottom: 1.5;
  }
  .machine-name {
    font-size: 2.5;
    color: #00ffff;
    font-weight: bold;
    margin-bottom: 0.5;
  }
  .machine-desc {
    font-size: 1.3;
    color: #aabbbb;
    margin-bottom: 1.5;
  }
  .nav-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 1.5;
  }
  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.5;
    padding-right: 1.5;
    margin-left: 1;
    margin-right: 1;
    background-color: rgba(255, 136, 0, 0.08);
    border-color: #ff8800;
    border-width: 0.08;
    border-radius: 0.4;
    cursor: pointer;
  }
  .nav-text {
    font-size: 2;
    color: #ff8800;
    font-weight: bold;
  }
  .select-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70%;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 2;
    padding-right: 2;
    margin-bottom: 1;
    background-color: rgba(0, 255, 255, 0.08);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.5;
    cursor: pointer;
  }
  .select-text {
    font-size: 2;
    color: #00ffff;
    font-weight: bold;
  }
  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(255, 0, 255, 0.06);
    border-color: #ff00ff;
    border-width: 0.06;
    border-radius: 0.4;
    cursor: pointer;
  }
  .back-text { font-size: 1.6; color: #ff00ff; }
</style>
<div class="machines-panel">
  <span class="machines-title">MACHINES</span>
  <span id="machine-name" class="machine-name">Neon Starter</span>
  <span id="machine-desc" class="machine-desc">12 prizes | Grip: 70%</span>
  <div class="nav-row">
    <div id="btn-machine-prev" class="nav-btn"><span class="nav-text">&lt;</span></div>
    <div id="btn-machine-next" class="nav-btn"><span class="nav-text">&gt;</span></div>
  </div>
  <div id="btn-machine-select" class="select-btn"><span class="select-text">SELECT</span></div>
  <div id="btn-back-machines" class="back-btn"><span class="back-text">BACK</span></div>
</div>
