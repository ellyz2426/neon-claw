<panel>
  <view flexDirection="column" alignItems="center" padding="14" backgroundColor="#0a0a1acc" borderRadius="12" borderWidth="1" borderColor="#ff880088">
    <text fontSize="18" fontWeight="bold" color="#ff8800">🎰 Machine Skins</text>
    <text fontSize="9" color="#888888" marginTop="2">Customize your machine's look</text>
    <text id="ms-tickets" fontSize="10" color="#ffdd00" marginTop="4">🎫 0 tickets</text>
    <view flexDirection="column" width="100%" marginTop="8" gap="6">
      <view id="btn-ms-0" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-0" fontSize="14" marginRight="8">🎰</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-0" fontSize="11" fontWeight="bold" color="#ffffff">Standard</text>
          <text id="ms-desc-0" fontSize="8" color="#888888">Classic neon look</text>
        </view>
        <text id="ms-status-0" fontSize="9" color="#00ff88">EQUIPPED</text>
      </view>
      <view id="btn-ms-1" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-1" fontSize="14" marginRight="8">🪞</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-1" fontSize="11" fontWeight="bold" color="#ffffff">Chrome</text>
          <text id="ms-desc-1" fontSize="8" color="#888888">Sleek chrome finish</text>
        </view>
        <text id="ms-status-1" fontSize="9" color="#ffaa00">200 🎫</text>
      </view>
      <view id="btn-ms-2" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-2" fontSize="14" marginRight="8">🥇</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-2" fontSize="11" fontWeight="bold" color="#ffffff">Gold Plated</text>
          <text id="ms-desc-2" fontSize="8" color="#888888">Luxurious gold plating</text>
        </view>
        <text id="ms-status-2" fontSize="9" color="#ffaa00">500 🎫</text>
      </view>
      <view id="btn-ms-3" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-3" fontSize="14" marginRight="8">🌈</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-3" fontSize="11" fontWeight="bold" color="#ffffff">Holographic</text>
          <text id="ms-desc-3" fontSize="8" color="#888888">Shifting rainbow holo</text>
        </view>
        <text id="ms-status-3" fontSize="9" color="#ffaa00">750 🎫</text>
      </view>
      <view id="btn-ms-4" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-4" fontSize="14" marginRight="8">🖤</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-4" fontSize="11" fontWeight="bold" color="#ffffff">Obsidian</text>
          <text id="ms-desc-4" fontSize="8" color="#888888">Dark volcanic glass</text>
        </view>
        <text id="ms-status-4" fontSize="9" color="#ffaa00">1000 🎫</text>
      </view>
      <view id="btn-ms-5" flexDirection="row" alignItems="center" padding="8" backgroundColor="#ffffff11" borderRadius="6" borderWidth="1" borderColor="#ffffff22">
        <text id="ms-icon-5" fontSize="14" marginRight="8">💎</text>
        <view flexDirection="column" flex="1">
          <text id="ms-name-5" fontSize="11" fontWeight="bold" color="#ffffff">Prismatic</text>
          <text id="ms-desc-5" fontSize="8" color="#888888">Ultra-rare prismatic</text>
        </view>
        <text id="ms-status-5" fontSize="9" color="#ffaa00">1500 🎫</text>
      </view>
    </view>
    <view id="btn-ms-back" marginTop="10" padding="8" paddingLeft="20" paddingRight="20" backgroundColor="#ffffff22" borderRadius="6">
      <text fontSize="11" color="#ffffff">Back</text>
    </view>
  </view>
</panel>
