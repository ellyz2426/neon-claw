<style>
  .pause-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 8, 17, 0.95);
    border-color: #ffdd00;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .pause-title {
    font-size: 4;
    color: #ffdd00;
    font-weight: bold;
    margin-bottom: 2;
  }
  .pause-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70%;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 2;
    padding-right: 2;
    margin-bottom: 1;
    background-color: rgba(255, 221, 0, 0.08);
    border-color: #ffdd00;
    border-width: 0.08;
    border-radius: 0.5;
    cursor: pointer;
  }
  .pause-btn-text {
    font-size: 2.2;
    color: #ffdd00;
    font-weight: bold;
  }
  .quit-btn {
    border-color: #ff4444;
  }
  .quit-text {
    color: #ff4444;
  }
</style>
<div class="pause-panel">
  <span class="pause-title">PAUSED</span>
  <div id="btn-resume" class="pause-btn"><span class="pause-btn-text">RESUME</span></div>
  <div id="btn-quit" class="pause-btn quit-btn"><span class="pause-btn-text quit-text">QUIT</span></div>
</div>
