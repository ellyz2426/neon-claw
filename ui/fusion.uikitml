<style>
  .fusion-panel {
    display: flex;
    flex-direction: column;
    padding: 2;
    background-color: rgba(0, 0, 0, 0.92);
    border-color: #aa44ff;
    border-width: 0.15;
    border-radius: 1;
    gap: 0.8;
  }
  .fusion-title {
    font-size: 3;
    color: #aa44ff;
    font-weight: bold;
    text-align: center;
  }
  .fusion-subtitle {
    font-size: 1.3;
    color: #888888;
    text-align: center;
  }
  .fusion-stats {
    font-size: 1.2;
    color: #ffdd00;
    text-align: center;
  }
  .recipe-row {
    display: flex;
    flex-direction: column;
    padding: 0.8;
    background-color: rgba(170, 68, 255, 0.06);
    border-color: rgba(170, 68, 255, 0.2);
    border-width: 0.05;
    border-radius: 0.4;
    gap: 0.2;
  }
  .recipe-label {
    font-size: 1.5;
    color: #ffffff;
    font-weight: bold;
  }
  .recipe-info {
    font-size: 1.1;
    color: #aaaaaa;
  }
  .recipe-count {
    font-size: 1.1;
    color: #00ff88;
  }
  .fuse-btn {
    font-size: 1.4;
    color: #000000;
    background-color: #aa44ff;
    padding: 0.4;
    border-radius: 0.3;
    cursor: pointer;
    text-align: center;
    font-weight: bold;
  }
  .btn-back-f {
    font-size: 1.4;
    color: #aa44ff;
    background-color: rgba(170, 68, 255, 0.1);
    padding: 0.4;
    border-radius: 0.3;
    border-color: #aa44ff;
    border-width: 0.05;
    cursor: pointer;
    text-align: center;
  }
  .fusion-result {
    font-size: 1.8;
    color: #ffdd00;
    text-align: center;
    font-weight: bold;
  }
</style>
<div class="fusion-panel">
  <span class="fusion-title">⚗️ FUSION LAB</span>
  <span class="fusion-subtitle">Combine 3 prizes → 1 higher rarity</span>
  <span class="fusion-stats" id="fuse-tickets">Tickets: 0</span>
  <span class="fusion-stats" id="fuse-total">Fusions: 0</span>

  <div class="recipe-row">
    <span class="recipe-label">Common → Uncommon</span>
    <span class="recipe-info">3 Common prizes + 5 tickets</span>
    <span class="recipe-count" id="fuse-common-count">Available: 0</span>
    <span class="fuse-btn" id="btn-fuse-common" cursor="pointer">FUSE</span>
  </div>

  <div class="recipe-row">
    <span class="recipe-label">Uncommon → Rare</span>
    <span class="recipe-info">3 Uncommon prizes + 15 tickets</span>
    <span class="recipe-count" id="fuse-uncommon-count">Available: 0</span>
    <span class="fuse-btn" id="btn-fuse-uncommon" cursor="pointer">FUSE</span>
  </div>

  <div class="recipe-row">
    <span class="recipe-label">Rare → Epic</span>
    <span class="recipe-info">3 Rare prizes + 40 tickets</span>
    <span class="recipe-count" id="fuse-rare-count">Available: 0</span>
    <span class="fuse-btn" id="btn-fuse-rare" cursor="pointer">FUSE</span>
  </div>

  <div class="recipe-row">
    <span class="recipe-label">Epic → Legendary</span>
    <span class="recipe-info">3 Epic prizes + 100 tickets</span>
    <span class="recipe-count" id="fuse-epic-count">Available: 0</span>
    <span class="fuse-btn" id="btn-fuse-epic" cursor="pointer">FUSE</span>
  </div>

  <span class="fusion-result" id="fuse-result"></span>
  <span class="btn-back-f" id="btn-back-fusion" cursor="pointer">← BACK</span>
</div>
