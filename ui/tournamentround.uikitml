<ui>
  <panel background-color="#111133ee" border-radius="12" padding="16">
    <vertical gap="8" alignment="center">
      <text id="tr-title" font-size="22" color="#ffdd00" alignment="center">🏆 TOURNAMENT ROUND</text>
      <text id="tr-bracket" font-size="14" color="#00ffcc" alignment="center">Bracket Name</text>
      <text id="tr-round" font-size="16" color="#ffffff" alignment="center">Round 1/4</text>
      <text id="tr-name" font-size="18" color="#ff8844" alignment="center">Round Name</text>

      <vertical gap="4" padding="8">
        <text id="tr-machine" font-size="12" color="#aaaaaa" alignment="center">Machine: Neon Starter</text>
        <text id="tr-mode" font-size="12" color="#aaaaaa" alignment="center">Mode: Classic | Medium</text>
        <text id="tr-target" font-size="14" color="#ffdd00" alignment="center">Target: 500 pts</text>
        <text id="tr-mods" font-size="11" color="#ff6666" alignment="center">Modifiers: None</text>
        <text id="tr-reward" font-size="12" color="#00ff88" alignment="center">Reward: 50 🎫</text>
      </vertical>

      <vertical gap="4" padding="4">
        <text id="tr-bracket-vis" font-size="10" color="#888888" alignment="center">Bracket Progress</text>
        <text id="tr-r0" font-size="11" color="#444444" alignment="center">R1: ---</text>
        <text id="tr-r1" font-size="11" color="#444444" alignment="center">R2: ---</text>
        <text id="tr-r2" font-size="11" color="#444444" alignment="center">R3: ---</text>
        <text id="tr-r3" font-size="11" color="#444444" alignment="center">R4: ---</text>
      </vertical>

      <button id="btn-tr-play" background-color="#00884466" border-radius="6" padding="8">
        <text font-size="16" color="#00ffcc" alignment="center">⚔️ FIGHT!</text>
      </button>

      <button id="btn-tr-abandon" background-color="#44000066" border-radius="6" padding="4">
        <text font-size="11" color="#ff4444" alignment="center">Abandon Tournament</text>
      </button>

      <button id="btn-tr-back" background-color="#33333366" border-radius="6" padding="6">
        <text font-size="13" color="#aaaaaa" alignment="center">← Back</text>
      </button>
    </vertical>
  </panel>
</ui>
