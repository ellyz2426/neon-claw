<style>
  .ach-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 8, 17, 0.92);
    border-color: #aa44ff;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .ach-title {
    font-size: 2.8;
    color: #aa44ff;
    font-weight: bold;
    margin-bottom: 1;
