<style>
  .power-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 1;
    padding-right: 1;
    background-color: rgba(0, 8, 17, 0.85);
    border-color: #00ff88;
    border-width: 0.06;
    border-radius: 0.4;
  }
  .power-label {
    font-size: 0.9;
    color: #00ff88;
  }
  .power-bar {
    font-size: 1.2;
    color: #00ffff;
    font-weight: bold;
  }
</style>
