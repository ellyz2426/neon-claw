<style>
  .lb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 8, 17, 0.92);
    border-color: #ffdd00;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .lb-title {
    font-size: 3;
    color: #ffdd00;
    font-weight: bold;
    margin-bottom: 1.5;
  }
  .lb-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 0.5;
    padding-right: 0.5;
    margin-bottom: 0.2;
    background-color: rgba(255, 221, 0, 0.03);
    border-radius: 0.2;
  }
  .lb-rank { font-size: 1.3; color: #ffdd00; width: 8%; }
  .lb-score { font-size: 1.3; color: #00ffff; width: 30%; font-weight: bold; }
  .lb-mode { font-size: 1.1; color: #ff00ff; width: 30%; }
  .lb-date { font-size: 1; color: #667777; width: 32%; }
  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    margin-top: 1;
    background-color: rgba(255, 0, 255, 0.06);
    border-color: #ff00ff;
    border-width: 0.06;
    border-radius: 0.4;
    cursor: pointer;
  }
  .back-text { font-size: 1.6; color: #ff00ff; }
</style>
