<style>
  .stage-panel {
    display: flex;
    flex-direction: column;
    padding: 2;
    background-color: rgba(0, 0, 0, 0.92);
    border-color: #00ffff;
    border-width: 0.15;
    border-radius: 1;
    gap: 0.8;
  }
  .stage-title {
    font-size: 2.5;
    color: #00ffff;
    font-weight: bold;
    text-align: center;
  }
  .stage-season {
    font-size: 1.3;
    color: #888888;
    text-align: center;
  }
  .stage-row {
    display: flex;
    flex-direction: column;
    padding: 0.8;
    background-color: rgba(0, 255, 255, 0.05);
    border-color: rgba(0, 255, 255, 0.15);
    border-width: 0.05;
    border-radius: 0.4;
    gap: 0.2;
  }
  .stage-name {
    font-size: 1.8;
    color: #ffffff;
    font-weight: bold;
  }
  .stage-info {
    font-size: 1.1;
    color: #aaaaaa;
  }
  .stage-reward {
    font-size: 1.1;
    color: #ffdd00;
  }
  .stage-status {
    font-size: 1.2;
    color: #00ff88;
  }
  .stage-btn {
    font-size: 1.4;
    color: #000000;
    background-color: #00ffff;
    padding: 0.4;
    border-radius: 0.3;
    cursor: pointer;
    text-align: center;
    font-weight: bold;
  }
  .btn-back-s {
    font-size: 1.4;
    color: #00ffff;
    background-color: rgba(0, 255, 255, 0.1);
    padding: 0.4;
    border-radius: 0.3;
    border-color: #00ffff;
    border-width: 0.05;
    cursor: pointer;
    text-align: center;
  }
</style>
<div class="stage-panel">
  <span class="stage-season" id="cs-season">Season 1</span>
  <span class="stage-title" id="cs-title">Stages</span>

  <div class="stage-row">
    <span class="stage-name" id="st-name-0">Stage 1</span>
    <span class="stage-info" id="st-info-0">—</span>
    <span class="stage-reward" id="st-reward-0">Reward: —</span>
    <span class="stage-status" id="st-status-0">—</span>
    <span class="stage-btn" id="btn-stage-0" cursor="pointer">PLAY</span>
  </div>

  <div class="stage-row">
    <span class="stage-name" id="st-name-1">Stage 2</span>
    <span class="stage-info" id="st-info-1">—</span>
    <span class="stage-reward" id="st-reward-1">Reward: —</span>
    <span class="stage-status" id="st-status-1">—</span>
    <span class="stage-btn" id="btn-stage-1" cursor="pointer">PLAY</span>
  </div>

  <div class="stage-row">
    <span class="stage-name" id="st-name-2">Stage 3</span>
    <span class="stage-info" id="st-info-2">—</span>
    <span class="stage-reward" id="st-reward-2">Reward: —</span>
    <span class="stage-status" id="st-status-2">—</span>
    <span class="stage-btn" id="btn-stage-2" cursor="pointer">PLAY</span>
  </div>

  <div class="stage-row">
    <span class="stage-name" id="st-name-3">Stage 4</span>
    <span class="stage-info" id="st-info-3">—</span>
    <span class="stage-reward" id="st-reward-3">Reward: —</span>
    <span class="stage-status" id="st-status-3">—</span>
    <span class="stage-btn" id="btn-stage-3" cursor="pointer">PLAY</span>
  </div>

  <span class="btn-back-s" id="btn-back-stages" cursor="pointer">← BACK TO SEASONS</span>
</div>
